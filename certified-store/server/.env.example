# ---- Store ----
PORT=5050
NODE_ENV=production
# MongoDB (can be the same MongoDB server as the CRM – use a separate database name)
MONGODB_URI=mongodb://127.0.0.1:27017/certified_store
# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Public address of the store – used in emails (login + reset links)
STORE_URL=https://store.certifiedortho.com

# First store admin, created automatically on start if there is no admin yet (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Store admin

# ---- CRM (crmcertifiedortho.com) – NO CRM code changes, the store uses its API ----
CRM_URL=https://crmcertifiedortho.com
# Create a user for the store in the CRM (CRM > Users), then put its login here.
CRM_SERVICE_EMAIL=
CRM_SERVICE_PASSWORD=
# Same endpoint the current website "Become a Certified Ortho Customer" form uses
CRM_PUBLIC_LEADS_PATH=/api/public/leads

# ---- Email (customer logins, order confirmations, notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Certified Ortho <info@certifiedortho.com>
# Who receives "new account request" / "new order" / contact-form emails
OWNER_EMAIL=info@certifiedortho.com

# remote = images/PDFs load from certifiedortho.com
# local  = run `npm run mirror-media` once, then serve them from this server
MEDIA_MODE=remote
UPLOAD_DIR=uploads
